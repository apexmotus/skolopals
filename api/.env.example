# See README.md "Environment variables" for where each of these comes from
# in the Supabase dashboard.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase project's DIRECT connection string — port 5432, session mode, by
# default (see docs/nestjs-api-plan/04-phase0-schema-port-and-cutover-strategy.md
# §1). If Supabase's dashboard ever shows this project nearing its connection
# limit under real traffic, switch to the 6543 Supavisor transaction-pooler
# string instead — same shape, no code change needed.
# Dashboard: Project Settings -> Database -> Connection string -> URI (mode: Session).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=true

# Optional. Access tokens are verified against the project's JWKS endpoint
# (SUPABASE_URL/auth/v1/.well-known/jwks.json). Only needed if the project's
# current signing key is still the legacy HS256 secret
# (Dashboard: Project Settings -> JWT Keys -> Legacy JWT secret).
# Treat with the same care as a database password; never log it.
SUPABASE_JWT_SECRET=

# Dashboard: Project Settings -> API -> Project URL / service_role key.
# Scoped in this API to common/file-storage/ only (tutor-documents bucket
# signed URLs) and one-off admin scripts — never used for per-request data
# access (see phase0 §1/§3).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3001

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

SWAGGER_ENABLED=true

REDIS_URL=redis://localhost:6379
