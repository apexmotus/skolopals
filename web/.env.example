NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Absolute site origin used for social preview URLs.
NEXT_PUBLIC_SITE_URL=https://skolopals.com

# The NestJS API (../api). Server-only — never exposed to the browser. Locally, `api/` runs on
# port 3000 (its default) and `web/` runs on 3001 (`npm run dev` passes -p 3001) to avoid the
# port collision; in each deployed environment this points at that environment's `api/` URL.
API_URL=http://localhost:3000/api/v1
